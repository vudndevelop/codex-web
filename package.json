{
  "name": "codex-web",
  "version": "0.0.1",
  "files": [
    "local-build.json",
    "README.md",
    "scratch/asar/**/*",
    "src/server/**/*.js",
    "src/server/**/*.cjs",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": "src/server/main.js",
  "scripts": {
    "prepare": "./scripts/prepare && npm run build:server && npm run build:browser",
    "build": "npm run prepare:asar && npm run build:server && npm run build:browser",
    "launch:unpacked:server": "http-server ./scratch/asar/webview -a localhost -p 5175 -c-1",
    "launch:unpacked": "NODE_ENV=development electron ./scratch/asar --remote-debugging-port=9222",
    "dev:browser": "vite --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts && npm run version:assets && npm run compact:assets && npm run precompress",
    "version:assets": "node scripts/version-assets.mjs scratch/asar/webview",
    "compact:assets": "node scripts/compact-assets.mjs scratch/asar/webview/assets",
    "build:server": "cd src/server && tsc",
    "precompress": "node scripts/precompress.mjs scratch/asar/webview",
    "prepare:asar": "./scripts/prepare_asar",
    "preserver": "npm run build:server && npm run build:browser",
    "test": "npm run build:server && npm run build:browser && node --test test/*.test.mjs",
    "server": "CODEX_CLI_PATH=$(which codex) node src/server/main.js"
  },
  "repository": "git@github.com:maolei1024/codex-web.git",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@parcel/watcher": "2.5.6",
    "@tanstack/react-query": "^5.100.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.3",
    "glob": "^13.0.6",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp-cli": "^6.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "41.2.0",
    "http-server": "^14.1.1"
  }
}
